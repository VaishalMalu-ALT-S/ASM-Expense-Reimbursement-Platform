# Environment Variables for ASM Expense Platform
# Copy this file to .env and configure your environment secrets.
# NEVER commit real credentials or .env to version control!

# Supabase Project Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend AI & OCR Configuration (Server-Side Edge Functions Only!)
NVIDIA_API_KEY=nvapi-...
# Optional extra NVIDIA keys; configured keys are used round-robin with failover.
NVIDIA_API_KEY_2=nvapi-...
NVIDIA_API_KEY_3=nvapi-...
UNLIMITED_OCR_ENDPOINT=https://your-ocr-service.com/api/v1/extract
TESSERACT_OCR_ENDPOINT=https://your-ocr-service.com/api/v1/extract/tesseract
UNLIMITED_OCR_SERVICE_KEY=change-me
OCR_ALLOWED_IMAGE_HOSTS=your-project-ref.supabase.co

# Storage Buckets
SUPABASE_STORAGE_BUCKET_RECEIPTS=receipts

# App Settings
APP_ENV=development
APP_NAME=ASM Expense & Reimbursement
DEFAULT_CURRENCY=AED

