# ============================================================
# ASM EXPENSE — CURSOR IGNORE
# Purpose: Reduce unnecessary indexing/context usage.
# ============================================================

# -------------------------
# Git
# -------------------------
.git/
.git/objects/
.git/logs/
.git/hooks/

# -------------------------
# Flutter generated files
# -------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
coverage/

# -------------------------
# Android generated/build
# -------------------------
android/.gradle/
android/build/
android/app/build/
android/.idea/
android/captures/
android/local.properties

# -------------------------
# iOS generated/build
# -------------------------
ios/Pods/
ios/.symlinks/
ios/Flutter/ephemeral/
ios/Runner.xcworkspace/xcuserdata/
ios/build/

# -------------------------
# IDE files
# -------------------------
.idea/
.vscode/
*.iml

# -------------------------
# OS files
# -------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------------
# Logs
# -------------------------
*.log
logs/

# -------------------------
# Temporary files
# -------------------------
tmp/
temp/
*.tmp
*.temp
*.bak
*.swp
*.swo

# -------------------------
# Local environment/secrets
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# Credentials / keys
# -------------------------
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials.json
service-account.json
google-services.json

# -------------------------
# Local databases/cache
# -------------------------
*.db
*.sqlite
*.sqlite3

# -------------------------
# Large media
# -------------------------
*.mp4
*.mov
*.avi
*.mkv
*.zip
*.rar
*.7z
*.tar
*.gz

# -------------------------
# Generated documentation
# -------------------------
*.pdf

# -------------------------
# Generated reports
# -------------------------
reports/generated/
exports/generated/

# -------------------------
# OCR temporary files
# -------------------------
ocr/tmp/
ocr/cache/

# -------------------------
# AI/cache files
# -------------------------
.ai-cache/
.cursor-cache/

# -------------------------
# Node artifacts if used by tooling
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# -------------------------
# Python artifacts if OCR tooling exists
# -------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
env/

# -------------------------
# Local test artifacts
# -------------------------
test_artifacts/
screenshots/